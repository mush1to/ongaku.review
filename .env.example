# GitHub: Settings > Secrets and variables > Actions に登録してください。
# このファイルは登録内容の見本です。Actionsは自動で読み込みません。

# Secrets > New repository secret
# 対象アカウントの Cloudflare Pages: Edit 権限を持つAPIトークン
CLOUDFLARE_API_TOKEN=

# Secrets > New repository secret
# CloudflareのアカウントID
CLOUDFLARE_ACCOUNT_ID=

# Variables > New repository variable
# 作成したPagesプロジェクト名。URLのマスクを避けるためVariableに登録します。
CLOUDFLARE_PAGES_PROJECT_NAME=

# Variables > New repository variable
# 初期設定後、本番サイトへの反映とプレビュー作成を許可するときにtrueへ変更します。
# 未登録またはtrue以外の場合は、新しいデプロイを受け付けません。
PAGES_DEPLOY_ENABLED=false
