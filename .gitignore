# OS の自動生成ファイル: Linux
.directory
.Trash-*/
.nfs*
.fuse_hidden*

# エディターの作業ファイル: 共通
*~

# エディターの作業ファイル: Vim
*.swp
*.swo

# エディターの作業ファイル: Emacs
.#*
\#*#

# エディターの作業ファイル: Visual Studio Code
.vscode/*
!.vscode/extensions.json

# エディターの作業ファイル: JetBrains
.idea/

# エージェントのローカル設定
.claude/settings.local.json

