*.tmp
*.temp
*.bak
*.orig
*.rej

# ログ
*.log

# ローカル環境設定（サンプルは共有する）
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.local

# API キー・認証情報
.secrets
.credentials
secrets.json
credentials.json
api-key.txt
api_key.txt

